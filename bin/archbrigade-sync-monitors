#!/bin/bash

# Convert ~/.config/hypr/monitors.conf (hyprlang syntax, as written by
# nwg-displays) into ~/.config/hypr/monitors.lua for Hyprland's Lua config.
# nwg-displays only understands .conf files, so re-run this after saving a
# layout there.
#
# Usage: archbrigade-sync-monitors [monitors.conf [monitors.lua]]

set -euo pipefail

monitors_conf="${1:-$HOME/.config/hypr/monitors.conf}"
monitors_lua="${2:-$HOME/.config/hypr/monitors.lua}"

if [[ ! -f $monitors_conf ]]; then
  echo "No $monitors_conf found (nwg-displays writes it). Nothing to convert." >&2
  exit 1
fi

tmp_file=$(mktemp)
trap 'rm -f "$tmp_file"' EXIT

awk '
  function trim(s) {
    gsub(/^[ \t]+|[ \t]+$/, "", s)
    return s
  }

  function luaval(s) {
    if (s ~ /^-?[0-9]+(\.[0-9]+)?$/) return s
    if (s == "true" || s == "false") return s
    gsub(/\\/, "\\\\", s)
    gsub(/"/, "\\\"", s)
    return "\"" s "\""
  }

  function luakey(k) {
    if (k ~ /^[A-Za-z_][A-Za-z0-9_]*$/) return k
    return "[" luaval(k) "]"
  }

  /^[ \t]*monitor[ \t]*=/ {
    line = $0
    sub(/^[ \t]*monitor[ \t]*=[ \t]*/, "", line)
    sub(/[ \t]+#.*$/, "", line)

    n = split(line, f, ",")
    for (i = 1; i <= n; i++) f[i] = trim(f[i])
    if (n < 1 || f[1] == "") next

    # Directives like addreserved are not monitor specs; keep them visible.
    if (n >= 2 && f[2] == "addreserved") {
      printf "-- unconverted monitors.conf directive (add it to another hypr/*.lua file by hand):\n-- %s\n", $0
      next
    }

    args = "output = " luaval(f[1])

    if (n >= 2 && f[2] == "disable") {
      args = args ", disabled = true"
      extras = 3
    } else {
      if (n >= 2 && f[2] != "") args = args ", mode = " luaval(f[2])
      if (n >= 3 && f[3] != "") args = args ", position = " luaval(f[3])
      if (n >= 4 && f[4] != "") args = args ", scale = " luaval(f[4])
      extras = 5
    }

    # Remaining fields are key,value pairs (transform, mirror, bitdepth, cm,
    # sdrbrightness, vrr, ...). Pass unknown keys through faithfully.
    for (i = extras; i + 1 <= n; i += 2) {
      args = args ", " luakey(f[i]) " = " luaval(f[i + 1])
    }

    # A dangling key without a value cannot be expressed as a Lua field.
    if (n >= extras && (n - extras + 1) % 2 == 1) {
      printf "-- unconverted trailing token from monitors.conf: %s\n", f[n]
    }

    printf "hl.monitor({ %s })\n", args
  }
' "$monitors_conf" >"$tmp_file"

if ! grep -q "hl.monitor" "$tmp_file"; then
  echo "No monitor= lines found in $monitors_conf; leaving $monitors_lua untouched." >&2
  exit 1
fi

{
  echo "-- generated by archbrigade-sync-monitors from monitors.conf; re-run after nwg-displays"
  echo "-- Do not edit by hand: the next sync overwrites this file."
  echo '-- Personal extras (e.g. hl.env("GDK_SCALE", "2")) belong in hypr/envs.lua or'
  echo "-- another hypr/*.lua file, not here."
  echo
  cat "$tmp_file"
} >"$monitors_lua"

echo "Wrote $monitors_lua from $monitors_conf."
