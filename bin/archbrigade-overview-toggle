#!/usr/bin/env bash
# Overview toggle - uses Quickshell IPC, starts it if not running yet

set -euo pipefail

qs_ipc_toggle() {
  qs ipc -c overview call overview toggle >/dev/null 2>&1
}

qs_wait_and_toggle() {
  local attempts=0
  while [[ $attempts -lt 8 ]]; do
    if qs_ipc_toggle; then
      return 0
    fi
    sleep 0.3
    (( attempts++ ))
  done
  return 1
}

# 1) Already running — just toggle (the daemon's process name is qs, not quickshell)
if pgrep -f "qs -c overview" >/dev/null 2>&1; then
  if qs_ipc_toggle; then
    exit 0
  fi
  # Running but IPC not ready yet — wait for it
  if qs_wait_and_toggle; then
    exit 0
  fi
  # Running but IPC dead — kill it so we can respawn a healthy instance,
  # instead of piling up duplicate daemons
  pkill -f "qs -c overview" 2>/dev/null || true
  sleep 0.2
fi

# 2) Not running — start it, then toggle
if command -v qs >/dev/null 2>&1; then
  qs -c overview >/dev/null 2>&1 &
  if qs_wait_and_toggle; then
    exit 0
  fi
fi

# 3) Fallback: AGS (legacy)
if command -v ags >/dev/null 2>&1; then
  pkill rofi 2>/dev/null || true
  if ags -t 'overview' >/dev/null 2>&1; then
    exit 0
  fi
  ags >/dev/null 2>&1 &
  sleep 0.6
  if ags -t 'overview' >/dev/null 2>&1; then
    exit 0
  fi
fi

notify-send "Overview" "Quickshell is not installed. Run: archbrigade-update" -u normal 2>/dev/null || true
exit 1
