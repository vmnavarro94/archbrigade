#!/bin/bash

if [[ -z $1 && $1 != "CNCLD" ]]; then
  echo "Usage: archbrigade-theme-set <theme-name>"
  exit 1
fi

THEMES_DIR="$HOME/.config/archbrigade/themes/"
CURRENT_THEME_DIR="$HOME/.config/archbrigade/current/theme"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Check if the theme entered exists
if [[ ! -d "$THEME_PATH" ]]; then
  echo "Theme '$THEME_NAME' does not exist in $THEMES_DIR"
  exit 1
fi

# Update theme symlinks
ln -nsf "$THEME_PATH" "$CURRENT_THEME_DIR"

# Change background with theme
archbrigade-theme-bg-next

# Restart components to apply new theme
archbrigade-restart-waybar
archbrigade-restart-swayosd
hyprctl reload
pkill -SIGUSR2 btop
makoctl reload

# Change gnome, browser, vscode themes
archbrigade-theme-set-terminal
archbrigade-theme-set-gnome
archbrigade-theme-set-eza
archbrigade-theme-set-browser
archbrigade-theme-set-vscode

# Helix editor theme (if installed)
if command -v hx &>/dev/null; then
  HELIX_THEME=$(cat ~/.config/archbrigade/current/theme/helix.txt 2>/dev/null)
  if [[ -n "$HELIX_THEME" ]]; then
    mkdir -p ~/.config/helix
    python3 -c "
import tomllib, tomli_w, pathlib, sys
p = pathlib.Path('$HOME/.config/helix/config.toml')
config = tomllib.loads(p.read_text()) if p.exists() else {}
config.setdefault('theme', '$HELIX_THEME')
config['theme'] = '$HELIX_THEME'
p.write_text(tomli_w.dumps(config))
" 2>/dev/null || sed -i \"s/^theme = .*/theme = \\\"$HELIX_THEME\\\"/\" ~/.config/helix/config.toml 2>/dev/null
  fi
fi
