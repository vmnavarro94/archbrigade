#!/usr/bin/env bash
# Dropdown terminal - simple show/hide, no animation

ADDR_FILE="/tmp/archbrigade_dropdown_addr"
WIDTH_PERCENT=80
HEIGHT_PERCENT=55

get_pos() {
  local info=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.x) \(.width) \(.height)"')
  local mx=$(echo $info | awk '{print $1}')
  local mw=$(echo $info | awk '{print $2}')
  local mh=$(echo $info | awk '{print $3}')
  local w=$(( mw * WIDTH_PERCENT / 100 ))
  local h=$(( mh * HEIGHT_PERCENT / 100 ))
  local x=$(( mx + (mw - w) / 2 ))
  echo "$x 26 $w $h"
}

get_addr() { [[ -f "$ADDR_FILE" ]] && cat "$ADDR_FILE"; }

addr=$(get_addr)
pos=$(get_pos)
tx=$(echo $pos | awk '{print $1}')
ty=$(echo $pos | awk '{print $2}')
tw=$(echo $pos | awk '{print $3}')
th=$(echo $pos | awk '{print $4}')

if [[ -z "$addr" ]] || ! hyprctl clients -j | jq -e --arg a "$addr" 'any(.[]; .address==$a)' >/dev/null 2>&1; then
  hyprctl dispatch exec "[float; size $tw $th; move $tx $ty; workspace special:dropdown silent] kitty --class archbrigade-dropdown"
  sleep 0.4
  addr=$(hyprctl clients -j | jq -r --arg c "archbrigade-dropdown" '[.[] | select(.class==$c)] | last | .address')
  echo "$addr" > "$ADDR_FILE"
fi

hyprctl dispatch togglespecialworkspace dropdown
hyprctl dispatch focuswindow "address:$addr"
