#!/usr/bin/env bash
# Dropdown terminal — hidden in special:dropdown workspace, shown on current workspace.
# Using special workspace (not pin+off-screen) avoids Hyprland correcting window
# position on workspace switch and focus restoration jumping to wrong workspace.

ADDR_FILE="/tmp/archbrigade_dropdown_addr"
PREV_FOCUS_FILE="/tmp/archbrigade_dropdown_prev_focus"
WIDTH_PERCENT=80
HEIGHT_PERCENT=55

get_geometry() {
  local info
  info=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.x) \(.width) \(.height)"')
  local mx mw mh w h x
  mx=$(echo "$info" | awk '{print $1}')
  mw=$(echo "$info" | awk '{print $2}')
  mh=$(echo "$info" | awk '{print $3}')
  w=$(( mw * WIDTH_PERCENT / 100 ))
  h=$(( mh * HEIGHT_PERCENT / 100 ))
  x=$(( mx + (mw - w) / 2 ))
  echo "$x 26 $w $h"
}

get_addr() { [[ -f "$ADDR_FILE" ]] && cat "$ADDR_FILE"; }

addr=$(get_addr)
pos=$(get_geometry)
tx=$(echo "$pos" | awk '{print $1}')
ty=$(echo "$pos" | awk '{print $2}')
tw=$(echo "$pos" | awk '{print $3}')
th=$(echo "$pos" | awk '{print $4}')

# Invalidate stale address
if [[ -n "$addr" ]] && ! hyprctl clients -j | jq -e --arg a "$addr" 'any(.[]; .address==$a)' >/dev/null 2>&1; then
  addr=""
  rm -f "$ADDR_FILE"
fi

# Spawn into special workspace if not running
if [[ -z "$addr" ]]; then
  hyprctl dispatch exec "[float; size $tw $th; nofocus] kitty --class archbrigade-dropdown"
  sleep 0.4
  addr=$(hyprctl clients -j | jq -r --arg c "archbrigade-dropdown" '[.[] | select(.class==$c)] | last | .address')
  echo "$addr" > "$ADDR_FILE"
  hyprctl dispatch movetoworkspacesilent "special:dropdown,address:$addr"
  # --hidden: pre-warm only, stay hidden
  [[ "$1" == "--hidden" ]] && exit 0
  # Freshly spawned → fall through to show logic
fi

# Determine visibility by workspace (special:dropdown = hidden)
ws=$(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address==$a) | .workspace.name')

if [[ "$ws" != "special:dropdown" ]]; then
  # Visible → move to special workspace (hide), restore focus on current workspace
  hyprctl dispatch movetoworkspacesilent "special:dropdown,address:$addr"
  current_ws=$(hyprctl activeworkspace -j | jq -r '.id')
  prev=$(cat "$PREV_FOCUS_FILE" 2>/dev/null)
  prev_ws=$(hyprctl clients -j | jq -r --arg a "$prev" '.[] | select(.address==$a) | .workspace.id' 2>/dev/null)
  if [[ -n "$prev" ]] && [[ "$prev_ws" == "$current_ws" ]] && hyprctl clients -j | jq -e --arg a "$prev" 'any(.[]; .address==$a)' >/dev/null 2>&1; then
    sleep 0.05
    hyprctl dispatch focuswindow "address:$prev" >/dev/null 2>&1
  else
    hyprctl dispatch cyclenext >/dev/null 2>&1
  fi
else
  # Hidden → move to current workspace, position, focus
  hyprctl activewindow -j | jq -r '.address' > "$PREV_FOCUS_FILE"
  ws_id=$(hyprctl activeworkspace -j | jq -r '.id')
  hyprctl dispatch movetoworkspace "$ws_id,address:$addr"
  hyprctl dispatch movewindowpixel "exact $tx ${ty},address:$addr"
  sleep 0.05
  hyprctl dispatch focuswindow "address:$addr"
fi
