#!/bin/bash

# Toggle dropdown terminal and ensure correct position
MONITOR_WIDTH=$(hyprctl monitors -j | jq '.[0].width')
MONITOR_HEIGHT=$(hyprctl monitors -j | jq '.[0].height')
WIN_W=$(( MONITOR_WIDTH * 80 / 100 ))
WIN_H=$(( MONITOR_HEIGHT * 40 / 100 ))
WIN_X=$(( (MONITOR_WIDTH - WIN_W) / 2 ))

# Check if dropdown is currently visible
ACTIVE_SPECIAL=$(hyprctl activewindow -j 2>/dev/null | jq -r '.workspace.name // ""')

hyprctl dispatch togglespecialworkspace dropdown

# After showing, reposition correctly
if [[ "$ACTIVE_SPECIAL" != "special:dropdown" ]]; then
  sleep 0.1
  hyprctl dispatch movewindowpixel "exact $WIN_X 0,class:archbrigade-dropdown"
  hyprctl dispatch resizewindowpixel "exact $WIN_W $WIN_H,class:archbrigade-dropdown"
fi
