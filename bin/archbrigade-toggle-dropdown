#!/usr/bin/env bash

# Dropdown terminal - uses Hyprland native slidevert animation
SPECIAL_WS="special:dropdown"
ADDR_FILE="/tmp/archbrigade_dropdown_addr"
TERMINAL_CLASS="archbrigade-dropdown"
WIDTH_PERCENT=80
HEIGHT_PERCENT=55
Y_OFFSET=26  # waybar height

get_pos() {
  local info=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.x) \(.y) \(.width) \(.height)"')
  local mw=$(echo $info | awk '{print $3}')
  local mh=$(echo $info | awk '{print $4}')
  local w=$(( mw * WIDTH_PERCENT / 100 ))
  local h=$(( mh * HEIGHT_PERCENT / 100 ))
  local x=$(( (mw - w) / 2 ))
  echo "$x $Y_OFFSET $w $h"
}

get_addr() { [[ -f "$ADDR_FILE" ]] && cat "$ADDR_FILE"; }

exists() {
  local a=$(get_addr)
  [[ -n "$a" ]] && hyprctl clients -j | jq -e --arg a "$a" 'any(.[]; .address == $a)' >/dev/null 2>&1
}

is_visible() {
  local a=$(get_addr)
  [[ -n "$a" ]] && hyprctl clients -j | jq -e --arg a "$a" 'any(.[]; .address == $a and .workspace.name != "special:dropdown")' >/dev/null 2>&1
}

pos=$(get_pos)
tx=$(echo $pos | awk '{print $1}')
ty=$(echo $pos | awk '{print $2}')
tw=$(echo $pos | awk '{print $3}')
th=$(echo $pos | awk '{print $4}')
cur_ws=$(hyprctl activeworkspace -j | jq -r '.id')

if ! exists; then
  hyprctl dispatch exec "[float; size $tw $th; workspace $SPECIAL_WS silent] kitty --class $TERMINAL_CLASS"
  sleep 0.4
  addr=$(hyprctl clients -j | jq -r --arg c "$TERMINAL_CLASS" '[.[] | select(.class == $c)] | last | .address')
  echo "$addr" > "$ADDR_FILE"
  hyprctl dispatch togglespecialworkspace dropdown
  sleep 0.05
  hyprctl dispatch movewindowpixel "exact $tx $ty,address:$addr"
  hyprctl dispatch focuswindow "address:$addr"
elif is_visible; then
  hyprctl dispatch togglespecialworkspace dropdown
else
  hyprctl dispatch togglespecialworkspace dropdown
  sleep 0.05
  addr=$(get_addr)
  hyprctl dispatch movewindowpixel "exact $tx $ty,address:$addr"
  hyprctl dispatch resizewindowpixel "exact $tw $th,address:$addr"
  hyprctl dispatch focuswindow "address:$addr"
fi
