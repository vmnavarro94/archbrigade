#!/usr/bin/env bash
# Dropdown terminal - position BEFORE toggle, let Hyprland animate

ADDR_FILE="/tmp/archbrigade_dropdown_addr"
WIDTH_PERCENT=80
HEIGHT_PERCENT=55

get_pos() {
  local info=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.x) \(.width) \(.height)"')
  local mx=$(echo $info | awk '{print $1}')
  local mw=$(echo $info | awk '{print $2}')
  local mh=$(echo $info | awk '{print $3}')
  local w=$(( mw * WIDTH_PERCENT / 100 ))
  local h=$(( mh * HEIGHT_PERCENT / 100 ))
  local x=$(( mx + (mw - w) / 2 ))
  echo "$x 26 $w $h"
}

get_addr() { [[ -f "$ADDR_FILE" ]] && cat "$ADDR_FILE"; }

addr=$(get_addr)
pos=$(get_pos)
tx=$(echo $pos | awk '{print $1}')
ty=$(echo $pos | awk '{print $2}')
tw=$(echo $pos | awk '{print $3}')
th=$(echo $pos | awk '{print $4}')

# Check terminal exists
if [[ -z "$addr" ]] || ! hyprctl clients -j | jq -e --arg a "$addr" 'any(.[]; .address==$a)' >/dev/null 2>&1; then
  hyprctl dispatch exec "[float; size $tw $th; workspace special:dropdown silent] kitty --class archbrigade-dropdown"
  sleep 0.4
  addr=$(hyprctl clients -j | jq -r --arg c "archbrigade-dropdown" '[.[] | select(.class==$c)] | last | .address')
  echo "$addr" > "$ADDR_FILE"
fi

ws=$(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address==$a) | .workspace.name')

if [[ "$ws" == "special:dropdown" ]]; then
  # Position correctly WHILE hidden, then toggle to show
  hyprctl dispatch movewindowpixel "exact $tx $ty,address:$addr" >/dev/null 2>&1
  hyprctl dispatch resizewindowpixel "exact $tw $th,address:$addr" >/dev/null 2>&1
  sleep 0.05
  hyprctl dispatch togglespecialworkspace dropdown
  hyprctl dispatch focuswindow "address:$addr"
else
  # Hide
  hyprctl dispatch togglespecialworkspace dropdown
fi
