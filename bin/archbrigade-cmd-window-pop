#!/bin/bash

# Toggle pop-out: float, resize, center and pin a window over all workspaces.
# Running again on a pinned window restores it to tiling.

WIDTH=${1:-1300}
HEIGHT=${2:-900}

ACTIVE=$(hyprctl activewindow -j)
PINNED=$(echo "$ACTIVE" | jq ".pinned")
ADDR=$(echo "$ACTIVE" | jq -r ".address")

[[ -z $ADDR || $ADDR == "null" ]] && exit 1

WINDOW="address:$ADDR"

# Dispatch via the Lua config provider, falling back to legacy hyprlang syntax.
hypr_dispatch() {
  local lua="$1"
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null 2>&1
}

if [[ $PINNED == "true" ]]; then
    hypr_dispatch "hl.dsp.window.pin({ window = \"$WINDOW\" })" pin "$WINDOW"
    hypr_dispatch "hl.dsp.window.float({ window = \"$WINDOW\", action = \"toggle\" })" togglefloating "$WINDOW"
else
    hypr_dispatch "hl.dsp.window.float({ window = \"$WINDOW\", action = \"toggle\" })" togglefloating "$WINDOW"
    hypr_dispatch "hl.dsp.window.resize({ window = \"$WINDOW\", x = $WIDTH, y = $HEIGHT })" resizewindowpixel "exact $WIDTH $HEIGHT,$WINDOW"
    hypr_dispatch "hl.dsp.window.center({ window = \"$WINDOW\" })" centerwindow
    hypr_dispatch "hl.dsp.window.pin({ window = \"$WINDOW\" })" pin "$WINDOW"
fi
