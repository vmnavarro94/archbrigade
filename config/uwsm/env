# Changes require a relaunch of Hyprland to take effect.

# Ensure ArchBrigade bins are in the path
export ARCHBRIGADE_PATH=$HOME/.local/share/archbrigade
export PATH=$ARCHBRIGADE_PATH/bin/:$PATH

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
archbrigade-cmd-present mise && eval "$(mise activate bash)"
